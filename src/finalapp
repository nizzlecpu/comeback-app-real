              <div style={{ display: "flex", gap: 8 }}>
                <button onClick={() => window.open(PLAN_PRO_URL, "_blank")} style={{ flex: 1, padding: 12, borderRadius: 10, background: T.textPrimary, color: T.bg, fontWeight: 800, fontSize: 12, border: "none", cursor: "pointer" }}>Get Pro</button>
                <button onClick={() => window.open(PLAN_ELITE_URL, "_blank")} style={{ flex: 1, padding: 12, borderRadius: 10, background: T.neon, color: T.bg, fontWeight: 800, fontSize: 12, border: "none", cursor: "pointer", boxShadow: shadow.neon }}>Get Elite</button>
              </div>
            </Card>
          ) : (() => {
            const tier = getRewardTier(saved.plan, totalRecoveryDays);
            if (!tier) return null;
            return (
              <>
                <NeonCard style={{ marginBottom: 16 }}>
                  <div style={{ fontWeight: 800, fontSize: 10, color: T.neon, marginBottom: 8, letterSpacing: "1px" }}>YOUR REWARD</div>
                  <div style={{ fontWeight: 900, fontSize: 22, color: T.textPrimary, marginBottom: 6 }}>{tier.label}</div>
                  <div style={{ fontSize: 12, color: T.textSecondary, lineHeight: 1.5 }}>
                    Based on your {injury?.label.toLowerCase() || "injury"} recovery running {totalRecoveryDays} days on the {saved.plan === "elite" ? "Elite" : "Pro"} plan.
                  </div>
                </NeonCard>
                <Card style={{ marginBottom: 16 }}>
                  <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 8 }}>
