const CURTIS_CONTACT = { phone: "929-432-8785", email: "comebacktrainer@gmail.com" };
const CURTIS_FAQ: { keywords: string[]; answer: string }[] = [
  { keywords: ["score", "gauge", "credit", "1-100", "number"], answer: "Your Recovery Score (1-100) lives on the Score tab. It updates live from your daily protocol completion, your nutrition logging, and — once it's built — your Diary check-ins. It reflects your whole recovery timeline, not just today." },
  { keywords: ["plan", "subscription", "price", "cost", "pro", "elite", "upgrade", "cancel", "billing", "stripe", "refund"], answer: "Comeback has two plans: Pro ($9.99/mo) and Elite ($28.99/mo — adds your live Recovery Score, Diary, and Rewards). See full plan details any time from the Score tab. You can manage or cancel your subscription through Stripe whenever you'd like." },
  { keywords: ["protocol", "today", "workout", "exercise", "task", "phase"], answer: "Your daily tasks live under the Today button (the big one in the middle of the bottom nav). The Protocol tab shows your whole recovery roadmap, phase by phase." },
  { keywords: ["squad", "post", "community", "team", "reply", "like"], answer: "Squad is your community feed with athletes recovering from the same sport and injury as you — post, like, and reply right from the Squad tab." },
  { keywords: ["diary", "journal", "feelings", "mood", "emotions", "goals"], answer: "Diary is your personal recovery journal — a new reflection prompt every day, saved day by day so nothing gets overwritten, with the option to attach a photo. Completing it also helps your Recovery Score." },
  { keywords: ["reward", "gift card", "tee", "shirt", "prize", "amazon"], answer: "Rewards unlock once you complete your full recovery program without cancelling or getting refunded. Pro members get a $15-$25 Amazon gift card; Elite members get a $25-$50 Amazon gift card plus a Comeback tee, depending on recovery length. Full terms are on the Rewards tab." },
  { keywords: ["streak", "fire"], answer: "Your streak grows by one every day you actually open Comeback exactly one day after your last visit. Miss a day and it resets — it only counts real, daily use." },
  { keywords: ["sign in", "login", "log in", "account", "sync", "password", "device", "lost", "delete", "app store", "code"], answer: "Comeback isn't in an app store, so your progress never lives on just one device. Tap the account icon on the Home tab and sign in with your email — we'll send a secure one-time sign-in link, no password to remember, and everything syncs right back." },
  { keywords: ["doctor", "medical", "injury", "safe", "hurt", "physician"], answer: "Comeback is not a doctor and isn't a substitute for medical care — always get examined and cleared by a licensed physician before and during your recovery. Think of Comeback as the structured, science-backed system that works alongside your medical care, not instead of it." },
  { keywords: ["contact", "support", "human", "person", "phone", "email", "reach"], answer: `You can reach the Comeback team directly at ${CURTIS_CONTACT.phone} or ${CURTIS_CONTACT.email}.` },
];
function getCurtisReply(input: string): string {
  const text = input.toLowerCase();
  let best: { answer: string; score: number } | null = null;
  for (const entry of CURTIS_FAQ) {
    const score = entry.keywords.reduce((acc, kw) => acc + (text.includes(kw) ? 1 : 0), 0);
    if (score > 0 && (!best || score > best.score)) best = { answer: entry.answer, score };
  }
  if (best) return best.answer;
  return `I'm not totally sure on that one — try asking about your Score, Protocol, Squad, Diary, Rewards, or your plan. Or reach the team directly at ${CURTIS_CONTACT.phone} / ${CURTIS_CONTACT.email}.`;
}
