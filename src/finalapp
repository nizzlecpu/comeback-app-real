// ── RECOVERY SCORE (Elite-exclusive) ────────────────────────────────────────────
// A single 1-100 number, presented exactly like a credit-score gauge (red
// 1-40 / yellow 41-65 / green 66-100, needle sweeping left to right), built
// from two real, non-decorative inputs: (1) how consistently the user
// actually completes their daily protocol tasks, and (2) how closely their
// logged calories track the target their own height/weight/goal produce via
// calcMacros(). Nothing here is cosmetic — a 90 score means real adherence.
function computeRecoveryScore(saved: SavedState, macros: { calories: number } | null): { score: number; taskScore: number; calorieScore: number | null; diaryScore: number | null } {
  // Task-completion component: total tasks actually checked off vs. total
  // tasks that were on the schedule, across every day that's been logged.
  const taskEntries = Object.entries(saved.completedTasks || {});
  let taskScore = 55; // neutral starting point before there's any history yet
  if (taskEntries.length) {
    let expected = 0, done = 0;
    for (const [dateKey, arr] of taskEntries) {
      const dNum = Math.max(1, daysBetween(saved.startDate, dateKey) + 1);
      const dayExpected = DAY_PROTOCOLS[dNum % DAY_PROTOCOLS.length]?.length || arr.length;
      expected += dayExpected;
      done += arr.filter(Boolean).length;
    }
    taskScore = expected > 0 ? Math.round((done / expected) * 100) : 55;
  }
  // Calorie-alignment component: how close logged net calories (food minus
  // exercise burned) land to the target calcMacros() produced. Only counts
  // days something was actually logged — unlogged days don't drag it down.
  let calorieScore: number | null = null;
  if (macros && macros.calories > 0) {
    const logEntries = Object.entries(saved.dailyLogs || {});
    const dayScores: number[] = [];
    for (const [, log] of logEntries) {
      const consumed = (log.meals || []).reduce((s, m) => s + (m.calories || 0), 0);
      const burned = (log.exercises || []).reduce((s, e) => s + (e.caloriesBurned || 0), 0);
      if (consumed === 0 && burned === 0) continue;
      const net = consumed - burned;
      const offPct = Math.abs(net - macros.calories) / macros.calories;
      dayScores.push(Math.max(0, Math.min(100, Math.round(100 - offPct * 140))));
    }
    if (dayScores.length) calorieScore = Math.round(dayScores.reduce((a, b) => a + b, 0) / dayScores.length);
  }
  // Diary component: what fraction of the days elapsed so far in this recovery
  // (from startDate through today) have a completed Diary entry. Each date is
  // its own key, so a day already saved never gets re-scored by a later day —
  // this is a running completion rate over the whole timeline, not a one-day
  // toggle, same principle as the task-completion component above.
  let diaryScore: number | null = null;
  const diaryDoneCount = Object.keys(saved.diaryEntries || {}).length;
  if (diaryDoneCount > 0) {
    const elapsedDays = Math.max(1, daysBetween(saved.startDate, todayStr()) + 1);
    diaryScore = Math.max(0, Math.min(100, Math.round((diaryDoneCount / elapsedDays) * 100)));
  }
  let score: number;
  if (calorieScore != null && diaryScore != null) {
    score = Math.round(taskScore * 0.5 + calorieScore * 0.25 + diaryScore * 0.25);
  } else if (calorieScore != null) {
    score = Math.round(taskScore * 0.6 + calorieScore * 0.4);
  } else if (diaryScore != null) {
    score = Math.round(taskScore * 0.7 + diaryScore * 0.3);
  } else {
    score = taskScore;
  }
  return { score: Math.max(1, Math.min(100, score)), taskScore, calorieScore, diaryScore };
}
function scoreBand(score: number): { label: string; color: string } {
  if (score <= 40) return { label: "NEEDS WORK", color: T.red };
  if (score <= 65) return { label: "BUILDING", color: "#F5A623" };
  return { label: "ON TRACK", color: T.neon };
}
