// ── RECOVERY SCORE GAUGE — credit-score-style dial (SVG, Elite-exclusive) ─────
// Semicircle gauge, red -> yellow -> green bands, with a needle that actually
// points at the real computed score. This is the emotional centerpiece of
// Elite: a number people can watch climb as they stay consistent, the same
// way consistent habits pay off over time.
function polarPoint(cx: number, cy: number, r: number, angleDeg: number) {
  const rad = (angleDeg * Math.PI) / 180;
  return { x: cx + r * Math.sin(rad), y: cy - r * Math.cos(rad) };
}
function gaugeArcPath(cx: number, cy: number, r: number, startDeg: number, endDeg: number) {
  const s = polarPoint(cx, cy, r, startDeg);
  const e = polarPoint(cx, cy, r, endDeg);
  const largeArc = Math.abs(endDeg - startDeg) > 180 ? 1 : 0;
  return `M ${s.x} ${s.y} A ${r} ${r} 0 ${largeArc} 1 ${e.x} ${e.y}`;
}
function RecoveryScoreGauge({ score, size = 220 }: { score: number; size?: number }) {
  const w = size;
  const h = Math.round(size * 0.62);
  const cx = w / 2;
  const cy = h - size * 0.08;
  const r = w * 0.4;
  const sw = Math.max(8, w * 0.09);
  const clamped = Math.max(1, Math.min(100, score));
  const angleForScore = (s: number) => -90 + (s / 100) * 180;
  const needleAngle = angleForScore(clamped);
  const band = scoreBand(clamped);
  const tip = polarPoint(cx, cy, r * 0.82, needleAngle);
  const oneLabel = polarPoint(cx, cy, r + sw * 0.9, -90);
  const hundredLabel = polarPoint(cx, cy, r + sw * 0.9, 90);
  return (
    <div style={{ width: w, textAlign: "center" }}>
      <svg width={w} height={h} viewBox={`0 0 ${w} ${h}`}>
        <path d={gaugeArcPath(cx, cy, r, -90, -18)} stroke={T.red} strokeWidth={sw} fill="none" strokeLinecap="round" />
        <path d={gaugeArcPath(cx, cy, r, -18, 27)} stroke="#F5A623" strokeWidth={sw} fill="none" strokeLinecap="round" />
        <path d={gaugeArcPath(cx, cy, r, 27, 90)} stroke={T.neon} strokeWidth={sw} fill="none" strokeLinecap="round" />
        <text x={oneLabel.x} y={oneLabel.y + 4} fontSize={Math.max(8, w * 0.04)} fontWeight={800} fill={T.textMuted} textAnchor="middle">1</text>
        <text x={hundredLabel.x} y={hundredLabel.y + 4} fontSize={Math.max(8, w * 0.04)} fontWeight={800} fill={T.textMuted} textAnchor="middle">100</text>
        <line x1={cx} y1={cy} x2={tip.x} y2={tip.y} stroke={T.textPrimary} strokeWidth={Math.max(2.5, w * 0.018)} strokeLinecap="round" />
        <circle cx={cx} cy={cy} r={Math.max(5, w * 0.032)} fill={T.textPrimary} stroke={T.bg} strokeWidth={2} />
        <text x={cx} y={cy - r * 0.32} fontSize={w * 0.19} fontWeight={900} fill={band.color} textAnchor="middle">{clamped}</text>
      </svg>
    </div>
  );
}

