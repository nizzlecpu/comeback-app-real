// ── ACCOUNT PANEL (sign in / create account / sync status) ────────────────────
function AccountPanel({ onClose, authUser }: {
  onClose: () => void;
  authUser: FirebaseUser | null;
}) {
  const [mode, setMode] = useState<"signin" | "signup" | "reset" | "link">("signin");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [info, setInfo] = useState<string | null>(null);

  // Note: this only signs the user in/up. The actual cloud <-> local merge
  // (newest updatedAt wins) and the redirect to the dashboard happen once,
  // globally, in App's onAuthStateChanged subscription — not here — so
  // there's exactly one merge per sign-in, not a duplicate race between this
  // panel and that subscription.
  const handleSubmit = async () => {
    if (!email.trim() || (mode === "signin" || mode === "signup") && !password) return;
    setBusy(true); setError(null); setInfo(null);
    if (mode === "reset") {
      const r = await sendResetEmail(email.trim());
      setBusy(false);
      if (r.ok) setInfo("Check your inbox for a password reset link.");
      else setError(r.error || "Couldn't send that reset email.");
      return;
    }
    if (mode === "link") {
      const r = await sendEmailSignInLink(email.trim());
      setBusy(false);
      if (r.ok) setInfo("Check your inbox — tap the link we sent to finish signing in on this device.");
      else setError(r.error || "Couldn't send that sign-in link.");
      return;
    }
    const r = mode === "signup" ? await signUpWithEmail(email.trim(), password) : await signInWithEmail(email.trim(), password);
    setBusy(false);
    if (!r.ok) { setError(r.error); return; }
    onClose();
  };
  const handleSignOut = async () => {
    if (firebaseAuth) await signOut(firebaseAuth);
    onClose();
  };

  return (
    <div style={{ position: "fixed", inset: 0, background: "rgba(0,0,0,0.6)", display: "flex", alignItems: "flex-end", justifyContent: "center", zIndex: 200 }} onClick={onClose}>
      <div onClick={e => e.stopPropagation()} style={{ width: "100%", maxWidth: 430, background: T.surface, borderTopLeftRadius: 24, borderTopRightRadius: 24, padding: "20px 20px calc(24px + env(safe-area-inset-bottom,0px))", maxHeight: "85vh", overflowY: "auto", boxSizing: "border-box" }}>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 16 }}>
          <div style={{ fontWeight: 900, fontSize: 18, color: T.textPrimary }}>{authUser ? "Account" : "Sync your progress"}</div>
          <button onClick={onClose} style={{ background: "none", border: "none", cursor: "pointer", color: T.textMuted }}><X size={20} /></button>
        </div>
        {!cloudSyncConfigured ? (
          <div style={{ fontSize: 13, color: T.textSecondary, lineHeight: 1.6 }}>
            Cloud sync isn't set up for this app yet (see <code style={{ color: T.neon }}>FIREBASE_SETUP.md</code>). Your progress is still safely saved on this device.
          </div>
        ) : authUser ? (
          <div>
            <div style={{ fontSize: 13, color: T.textSecondary, marginBottom: 4 }}>Signed in as</div>
            <div style={{ fontWeight: 800, fontSize: 15, color: T.textPrimary, marginBottom: 16, wordBreak: "break-all" }}>{authUser.email}</div>
            <div style={{ display: "flex", alignItems: "center", gap: 8, background: T.neonL, border: `1px solid ${T.neon}40`, borderRadius: 12, padding: "10px 12px", marginBottom: 16 }}>
              <Cloud size={15} color={T.neon} />
              <span style={{ fontSize: 12, color: T.textPrimary, fontWeight: 600 }}>Your progress syncs automatically across devices.</span>
            </div>
            <button onClick={handleSignOut} style={{ width: "100%", padding: 13, borderRadius: 12, background: "transparent", border: `1px solid ${T.border}`, color: T.textSecondary, fontWeight: 700, fontSize: 13, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", gap: 6 }}>
              <LogOut size={14} /> Sign out
            </button>
          </div>
        ) : (
          <div>
            <p style={{ fontSize: 13, color: T.textSecondary, marginBottom: 14, lineHeight: 1.5 }}>
              Create an account (or sign in) to back up your streak and protocol progress — pick up right where you left off on any device.
            </p>
            <div style={{ display: "flex", gap: 8, marginBottom: 14 }}>
              {(["signin", "signup"] as const).map(m => (
                <button key={m} onClick={() => { setMode(m); setError(null); setInfo(null); }}
                  style={{ flex: 1, padding: "9px", borderRadius: 10, border: `1.5px solid ${mode === m ? T.neon : T.border}`, background: mode === m ? T.neonL : "transparent", color: mode === m ? T.neon : T.textSecondary, fontWeight: 700, fontSize: 12, cursor: "pointer" }}>
                  {m === "signin" ? "Sign In" : "Create Account"}
                </button>
              ))}
            </div>
            <input value={email} onChange={e => setEmail(e.target.value)} placeholder="Email" type="email"
              style={{ width: "100%", padding: "12px 14px", borderRadius: 10, border: `1.5px solid ${T.border}`, background: T.card, color: T.textPrimary, fontSize: 13, outline: "none", boxSizing: "border-box", marginBottom: 8 }} />
            {(mode === "signin" || mode === "signup") && (
              <input value={password} onChange={e => setPassword(e.target.value)} placeholder="Password" type="password"
                style={{ width: "100%", padding: "12px 14px", borderRadius: 10, border: `1.5px solid ${T.border}`, background: T.card, color: T.textPrimary, fontSize: 13, outline: "none", boxSizing: "border-box", marginBottom: 8 }} />
            )}
            {mode === "link" && (
              <div style={{ fontSize: 11, color: T.textMuted, marginBottom: 8, lineHeight: 1.5 }}>No password needed — we'll email you a secure link that signs you straight back in on this device.</div>
            )}
            {error && <div style={{ fontSize: 11, color: T.red, marginBottom: 8 }}>{error}</div>}
            {info && <div style={{ fontSize: 11, color: T.neon, marginBottom: 8 }}>{info}</div>}
            <button onClick={handleSubmit} disabled={busy || !email.trim() || ((mode === "signin" || mode === "signup") && !password)}
