// ── Passwordless email sign-in ("send me a code to log back in") ──────────────
// Firebase's built-in email-link sign-in is the no-new-backend way to deliver
// this: no password to remember, no Cloud Function / SMS provider to stand up.
// A real typed 6-digit numeric code would need a custom backend (a function to
// generate + store + verify it, plus a transactional email sender) — out of
// scope while this stays on Firebase's free tier, so this substitutes Firebase's
// own passwordless flow, which is the same "get emailed something that logs
// you back in" experience the user asked for.
const EMAIL_LINK_STORAGE_KEY = "cbk_email_for_signin";
async function sendEmailSignInLink(email: string): Promise<{ ok: boolean; error?: string }> {
  if (!firebaseAuth) return { ok: false, error: "Cloud sync isn't set up yet." };
  try {
    await sendSignInLinkToEmail(firebaseAuth, email, {
      url: window.location.href,
      handleCodeInApp: true,
    });
    try { window.localStorage.setItem(EMAIL_LINK_STORAGE_KEY, email); } catch {}
    return { ok: true };
  } catch (err: any) {
    return { ok: false, error: friendlyAuthError(err?.code) };
  }
}
// Call once on app load. If the current URL is a Firebase sign-in link, finishes
// the sign-in automatically (using the email saved on this device when the link
// was requested) and strips the auth params from the URL so a refresh doesn't
// try to replay it. If the link was opened on a different device/browser than
// the one that requested it, we don't have the saved email, so we ask for it —
// Firebase requires the *same* email the link was generated for.
async function completeEmailLinkSignInIfNeeded(): Promise<void> {
  if (!firebaseAuth) return;
  if (!isSignInWithEmailLink(firebaseAuth, window.location.href)) return;
  let email: string | null = null;
  try { email = window.localStorage.getItem(EMAIL_LINK_STORAGE_KEY); } catch {}
  if (!email) email = window.prompt("Enter the email you used to request this sign-in link:");
  if (!email) return;
  try {
    await signInWithEmailLink(firebaseAuth, email, window.location.href);
    try { window.localStorage.removeItem(EMAIL_LINK_STORAGE_KEY); } catch {}
  } catch {
    // Swallow — a bad/expired link just leaves the user on the normal sign-in
    // screen instead of crashing the app.
  } finally {
    window.history.replaceState(null, "", window.location.pathname);
  }
}
function friendlyAuthError(code?: string): string {
  switch (code) {
    case "auth/email-already-in-use": return "An account already exists for that email — try signing in instead.";
    case "auth/invalid-email": return "That email address doesn't look right.";
    case "auth/weak-password": return "Password needs to be at least 6 characters.";
    case "auth/wrong-password": case "auth/invalid-credential": return "Wrong email or password.";
    case "auth/user-not-found": return "No account found for that email.";
    case "auth/too-many-requests": return "Too many attempts — wait a bit and try again.";
    default: return "Something went wrong. Please try again.";
  }
}

