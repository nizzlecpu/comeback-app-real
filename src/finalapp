const firebaseApp: FirebaseApp | null = FIREBASE_CONFIG.apiKey ? initializeApp(FIREBASE_CONFIG) : null;
const firebaseAuth: Auth | null = firebaseApp ? getAuth(firebaseApp) : null;
const firebaseDb: Firestore | null = firebaseApp ? getFirestore(firebaseApp) : null;
const cloudSyncConfigured = !!firebaseApp;

// Merge rule: newest `updatedAt` wins, wholesale (not field-by-field) — simple
// and correct for the common case of "used the app on one device at a time."
// If someone genuinely uses two devices simultaneously offline, the later
// sync wins and the earlier device's edits in that window are lost; there's
// no fancier CRDT-style merge here because the data (a single JSON blob per
// user) doesn't need one for this app's scale.
async function pullAndMergeCloudState(uid: string): Promise<SavedState | null> {
  if (!firebaseDb) return null;
  try {
    const snap = await getDoc(doc(firebaseDb, "users", uid));
    const local = loadState();
    if (!snap.exists()) {
      // No cloud copy yet — push whatever's local (if any) so this device
      // becomes the seed for future syncs.
      if (local) saveState(local);
      return local;
    }
    const cloud = snap.data() as SavedState;
    if (!local || (cloud.updatedAt || 0) > (local.updatedAt || 0)) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(cloud)); } catch {}
      return cloud;
    }
    // Local is newer (or equal) — push it up so the cloud catches up too.
    saveState(local);
    return local;
  } catch {
    return loadState();
  }
}
