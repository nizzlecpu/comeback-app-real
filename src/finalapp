              <LogIn size={15} /> {busy ? "Please wait…" : mode === "reset" ? "Send reset email" : mode === "link" ? "Email me a sign-in link" : mode === "signup" ? "Create account" : "Sign in"}
            </button>
            {mode === "signin" && (
              <button onClick={() => { setMode("link"); setError(null); setInfo(null); }} style={{ width: "100%", background: "none", border: "none", color: T.neon, fontSize: 11, fontWeight: 700, cursor: "pointer", marginBottom: 6 }}>Skip the password — email me a sign-in link</button>
            )}
            {mode !== "reset" && mode !== "link" && (
              <button onClick={() => { setMode("reset"); setError(null); setInfo(null); }} style={{ width: "100%", background: "none", border: "none", color: T.textMuted, fontSize: 11, cursor: "pointer" }}>Forgot password?</button>
            )}
            {(mode === "reset" || mode === "link") && (
              <button onClick={() => { setMode("signin"); setError(null); setInfo(null); }} style={{ width: "100%", background: "none", border: "none", color: T.textMuted, fontSize: 11, cursor: "pointer" }}>← Back to sign in</button>
            )}
          </div>
        )}
      </div>
    </div>
  );
}

// ── APP DASHBOARD ─────────────────────────────────────────────────────────────
function AppDashboard({ saved, onReset, onUpgrade, onOpenAccount, authUser }: {
  saved: SavedState; onReset: () => void; onUpgrade: (code: string) => void;
  onOpenAccount: () => void; authUser: FirebaseUser | null;
}) {
  const [tab, setTabRaw] = useState<"rewards" | "home" | "protocol" | "today" | "squad" | "diary" | "score">(() => loadLastTab());
  const setTab = useCallback((t: "rewards" | "home" | "protocol" | "today" | "squad" | "diary" | "score") => {
    setTabRaw(t); saveLastTab(t);
  }, []);
  // Ticks every 30s purely to force a re-render so the Elite-trial countdown
  // (and the lock that fires when it hits zero) update live without needing
  // a page refresh.
  const [nowTick, setNowTick] = useState(() => Date.now());
  useEffect(() => {
    const t = setInterval(() => setNowTick(Date.now()), 30000);
    return () => clearInterval(t);
  }, []);
  const trialActive = saved.plan === "trial" && !!saved.trialEndsAt && nowTick < saved.trialEndsAt;
  const trialExpired = saved.plan === "trial" && !!saved.trialEndsAt && nowTick >= saved.trialEndsAt;
  const eliteActive = saved.plan === "elite" || trialActive;
  const trialMsLeft = saved.trialEndsAt ? Math.max(0, saved.trialEndsAt - nowTick) : 0;
  const trialTimeLabel = (() => {
    const totalMin = Math.floor(trialMsLeft / 60000);
    const h = Math.floor(totalMin / 60), m = totalMin % 60;
    return h > 0 ? `${h}h ${m}m left` : `${m}m left`;
  })();
  const getLiveCount = (base: number) => {
    const daySeed = parseInt(todayStr().replace(/-/g,"")) % 100;
    const sportSeed = saved.sportId.length * 7;
    const variance = Math.floor(((daySeed + sportSeed) % 40) - 20);
    return Math.max(12, base + variance);
  };
  const [posts, setPosts] = useState<Post[]>(() => saved.posts?.[saved.sportId] || seedPosts(saved.sportId));
  const [replyingTo, setReplyingTo] = useState<string | null>(null);
  const [replyText, setReplyText] = useState("");
  const [newPost, setNewPost] = useState("");
  const [bodyProfile, setBodyProfile] = useState<BodyProfile | null>(saved.bodyProfile);
  const [suppChecked, setSuppChecked] = useState<boolean[]>(() => {
    const s = loadState(); return s?.suppChecked?.[todayStr()] ?? Array(SUPPLEMENTS.length).fill(false);
  });
  const sport    = SPORTS.find(s => s.id === saved.sportId);
  const injury   = INJURIES.find(i => i.id === saved.injuryId);
  const severity = SEVERITIES.find(s => s.id === saved.severityId);
  const dayNum  = Math.max(1, daysBetween(saved.startDate, todayStr()) + 1);
  const phase   = dayNum <= 42 ? 1 : dayNum <= 112 ? 2 : 3;
  const totalRecoveryDays = (injury?.weeks || 36) * 7;
  const pct     = Math.min(100, Math.round((dayNum / totalRecoveryDays) * 100));
  const recoveryComplete = dayNum >= totalRecoveryDays;
  const weekNum = Math.ceil(dayNum / 7);
  const todayKey = todayStr();
  const tasks = DAY_PROTOCOLS[dayNum % DAY_PROTOCOLS.length];
  const [checked, setChecked] = useState<boolean[]>(() => {
    const s = loadState(); return s?.completedTasks?.[todayKey] ?? Array(tasks.length).fill(false);
  });
  const doneCount = checked.filter(Boolean).length;
  const allDone   = doneCount === tasks.length;
  const toggleTask = useCallback((idx: number) => {
    setChecked(prev => {
      const next = [...prev]; next[idx] = !next[idx];
      const s = loadState();
      if (s) { s.completedTasks = s.completedTasks || {}; s.completedTasks[todayKey] = next; saveState(s); }
      return next;
    });
  }, [todayKey]);
  const toggleSupp = useCallback((idx: number) => {
    setSuppChecked(prev => {
      const next = [...prev]; next[idx] = !next[idx];
      const s = loadState();
      if (s) { s.suppChecked = s.suppChecked || {}; s.suppChecked[todayKey] = next; saveState(s); }
      return next;
    });
  }, [todayKey]);
  const dailyContent = DAILY_CONTENT[dayNum % DAILY_CONTENT.length];
  const morningTasks   = tasks.slice(0, 3);
  const afternoonTasks = tasks.slice(3, 7);
  const eveningTasks   = tasks.slice(7);
  const coachQuote = allDone
    ? COACH_QUOTES.goal[dayNum % COACH_QUOTES.goal.length]
    : !saved.streakAlive
    ? COACH_QUOTES.miss[dayNum % COACH_QUOTES.miss.length]
    : doneCount === 0
    ? COACH_QUOTES.morning[dayNum % COACH_QUOTES.morning.length]
    : COACH_QUOTES.streak[dayNum % COACH_QUOTES.streak.length];
  const macros = bodyProfile ? calcMacros(bodyProfile.heightFt, bodyProfile.heightIn, bodyProfile.weightLbs, bodyProfile.gender, saved.goalId) : null;
  // Yesterday's recap — "were they successful" pulled straight from the
  // completedTasks log, so it reflects what actually happened, not a guess.
  const yesterdayKey = offsetDateStr(todayKey, -1);
  const yesterdayDayNum = dayNum - 1;
  const showYesterdayRecap = yesterdayDayNum >= 1;
  const yesterdayTotal = showYesterdayRecap ? DAY_PROTOCOLS[yesterdayDayNum % DAY_PROTOCOLS.length].length : 0;
  const yesterdayDone = saved.completedTasks?.[yesterdayKey]?.filter(Boolean).length ?? 0;
  const yesterdaySuccess = showYesterdayRecap && yesterdayTotal > 0 && yesterdayDone === yesterdayTotal;
  // ── Daily food + exercise log (MyFitnessPal-style, Elite) ──────────────────
  const [todayLog, setTodayLog] = useState<DailyLog>(() => {
    const s = loadState(); return s?.dailyLogs?.[todayKey] || { meals: [], exercises: [] };
  });
  const addMeal = useCallback((name: string, calories: number) => {
    setTodayLog(prev => {
      const next: DailyLog = { ...prev, meals: [...prev.meals, { id: `m${Date.now()}${Math.random().toString(36).slice(2,6)}`, name, calories, time: new Date().toISOString() }] };
      const s = loadState();
      if (s) { s.dailyLogs = s.dailyLogs || {}; s.dailyLogs[todayKey] = next; saveState(s); }
      return next;
    });
  }, [todayKey]);
  const addExercise = useCallback((name: string, minutes: number, caloriesBurned: number) => {
    setTodayLog(prev => {
      const next: DailyLog = { ...prev, exercises: [...prev.exercises, { id: `e${Date.now()}${Math.random().toString(36).slice(2,6)}`, name, minutes, caloriesBurned, time: new Date().toISOString() }] };
      const s = loadState();
      if (s) { s.dailyLogs = s.dailyLogs || {}; s.dailyLogs[todayKey] = next; saveState(s); }
      return next;
    });
  }, [todayKey]);
  const removeMeal = useCallback((id: string) => {
    setTodayLog(prev => {
      const next: DailyLog = { ...prev, meals: prev.meals.filter(m => m.id !== id) };
      const s = loadState();
      if (s) { s.dailyLogs = s.dailyLogs || {}; s.dailyLogs[todayKey] = next; saveState(s); }
      return next;
    });
  }, [todayKey]);
  const removeExercise = useCallback((id: string) => {
    setTodayLog(prev => {
      const next: DailyLog = { ...prev, exercises: prev.exercises.filter(e => e.id !== id) };
      const s = loadState();
      if (s) { s.dailyLogs = s.dailyLogs || {}; s.dailyLogs[todayKey] = next; saveState(s); }
      return next;
    });
  }, [todayKey]);
  // ── Diary (Elite) ───────────────────────────────────────────────────────────
  const diaryPrompt = DIARY_PROMPTS[dayNum % DIARY_PROMPTS.length];
  const [diaryToday, setDiaryToday] = useState<DiaryEntry | null>(() => {
    const s = loadState(); return s?.diaryEntries?.[todayKey] || null;
  });
  const [diaryHistory, setDiaryHistory] = useState<Record<string, DiaryEntry>>(() => {
    const s = loadState(); return s?.diaryEntries || {};
  });
  const saveDiaryEntry = useCallback((answer: string, photoDataUrl: string | null) => {
    const entry: DiaryEntry = { date: todayKey, prompt: diaryPrompt, answer, photoDataUrl, savedAt: new Date().toISOString() };
    setDiaryToday(entry);
    setDiaryHistory(prev => ({ ...prev, [todayKey]: entry }));
    const s = loadState();
    if (s) { s.diaryEntries = s.diaryEntries || {}; s.diaryEntries[todayKey] = entry; saveState(s); }
  }, [todayKey, diaryPrompt]);
  const [diaryDraftAnswer, setDiaryDraftAnswer] = useState(() => diaryToday?.answer || "");
  const [diaryDraftPhoto, setDiaryDraftPhoto] = useState<string | null>(() => diaryToday?.photoDataUrl || null);
  const [diaryPhotoBusy, setDiaryPhotoBusy] = useState(false);
  const [diaryPhotoError, setDiaryPhotoError] = useState<string | null>(null);
  const handleDiaryPhotoChange = useCallback(async (file: File | undefined) => {
    if (!file) return;
    setDiaryPhotoBusy(true); setDiaryPhotoError(null);
    try { setDiaryDraftPhoto(await compressImageToDataUrl(file)); }
    catch { setDiaryPhotoError("Couldn't load that photo — try a different one."); }
    finally { setDiaryPhotoBusy(false); }
  }, []);
  // ── Rewards (Pro + Elite) ───────────────────────────────────────────────────
  const [rewardsConsent, setRewardsConsent] = useState(saved.rewardsConsent || null);
  const [rewardClaim, setRewardClaim] = useState(saved.rewardClaim || null);
  const [rewardBrandDraft, setRewardBrandDraft] = useState(GIFT_CARD_BRANDS[0]);
  const [rewardsAgreeChecked, setRewardsAgreeChecked] = useState(false);
  const agreeToRewardsContract = useCallback(() => {
    const consent = { agreedAt: new Date().toISOString() };
    setRewardsConsent(consent);
    const s = loadState();
    if (s) { s.rewardsConsent = consent; saveState(s); }
  }, []);
  const claimReward = useCallback((giftCardAmount: number, tee: boolean, brand: string) => {
    const claim = { claimedAt: new Date().toISOString(), giftCardAmount, tee, brand };
    setRewardClaim(claim);
    const s = loadState();
    if (s) { s.rewardClaim = claim; saveState(s); }
  }, []);
  // Recovery Score — recomputed live off today's actual in-session state
  // (checked tasks + today's log) layered on top of the saved history, so
  // checking off a task or logging a meal moves the needle immediately
  // instead of waiting for a remount.
  const scoreInputState: SavedState = {
    ...saved,
    completedTasks: { ...saved.completedTasks, [todayKey]: checked },
    dailyLogs: { ...saved.dailyLogs, [todayKey]: todayLog },
    diaryEntries: diaryHistory,
  };
  const recoveryScore = computeRecoveryScore(scoreInputState, macros);
  const handleLike = (postId: string) => {
    setPosts(prev => prev.map(p => p.id === postId ? { ...p, likes: p.likedByMe ? p.likes - 1 : p.likes + 1, likedByMe: !p.likedByMe } : p));
  };
  const handleReply = (postId: string) => {
    if (!replyText.trim()) return;
    const now = new Date().toISOString();
    setPosts(prev => prev.map(p => p.id === postId ? { ...p, replies: [...p.replies, { author: "You", msg: replyText.trim(), timestamp: now }] } : p));
    setReplyText(""); setReplyingTo(null);
  };
  const handleNewPost = () => {
    if (!newPost.trim()) return;
    const post: Post = { id: Date.now().toString(), author: "You", msg: newPost.trim(), likes: 0, likedByMe: false, timestamp: new Date().toISOString(), replies: [] };
    setPosts(prev => [post, ...prev]);
    setNewPost("");
    const s = loadState();
    if (s) { s.posts = s.posts || {}; s.posts[saved.sportId] = [post, ...(s.posts[saved.sportId] || [])]; saveState(s); }
    // A squadmate replies a few seconds later so a new post never just sits
    // there with zero engagement — same simulated-community pattern as the
    // pre-seeded posts/replies already in this feed.
    const autoReply = getSquadAutoReply(post.msg);
    setTimeout(() => {
      const reply = { author: autoReply.author, msg: autoReply.text, timestamp: new Date().toISOString() };
      setPosts(prev => prev.map(p => p.id === post.id ? { ...p, replies: [...p.replies, reply] } : p));
      const s2 = loadState();
      if (s2?.posts?.[saved.sportId]) {
        s2.posts[saved.sportId] = s2.posts[saved.sportId].map(p => p.id === post.id ? { ...p, replies: [...p.replies, reply] } : p);
        saveState(s2);
